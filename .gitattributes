# These run inside a Linux container with a shebang line -- a CRLF line
# ending breaks the interpreter lookup ("bad interpreter" errors). Force
# LF regardless of a contributor's local core.autocrlf setting.
*.sh text eol=lf
rootfs/etc/s6-overlay/s6-rc.d/**/run text eol=lf
rootfs/etc/s6-overlay/s6-rc.d/**/type text eol=lf
